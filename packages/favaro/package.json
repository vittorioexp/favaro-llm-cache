{
  "name": "favaro",
  "version": "0.1.0",
  "description": "Enterprise-grade caching library for Large Language Models",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "bin": {
    "favaro": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "benchmark": "node dist/benchmark.js"
  },
  "dependencies": {
    "@favaro/core": "workspace:*",
    "@favaro/memory": "workspace:*",
    "@favaro/providers": "workspace:*",
    "@favaro/semantic": "workspace:*",
    "@favaro/shared": "workspace:*"
  },
  "optionalDependencies": {
    "@favaro/redis": "workspace:*",
    "@favaro/sqlite": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "llm",
    "cache",
    "ai",
    "openai",
    "anthropic",
    "semantic-cache",
    "deduplication",
    "streaming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/favaro-llm/favaro-llm-cache"
  }
}
